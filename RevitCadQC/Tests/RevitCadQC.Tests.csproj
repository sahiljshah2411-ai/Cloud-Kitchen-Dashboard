<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the QC engine. They compile the engine sources from ..\Core directly
       (everything except Core\Revit, which needs a running Revit). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>RevitCadQC.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" Exclude="..\Core\Revit\**" LinkBase="Core" />
    <None Include="..\CadLayerDictionary.txt" Link="config\CadLayerDictionary.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ACadSharp" Version="[3.6.35]" />
  </ItemGroup>
</Project>
