<Project Sdk="Microsoft.NET.Sdk">
  <!--
    REVIT CAD QC - one project, one DLL (RevitCadQC.dll), same layout as AashirTools:
      App.cs        ribbon
      Commands\     one IExternalCommand per button
      Core\         QC engine (DXF/DWG reading, extraction, alignment, checks, reports) + Core\Revit (model access)
      UI\           WPF windows (code only, no XAML)
    Build:  dotnet build -c R2025      ->  bin\R2025\RevitCadQC.dll
            R2022 / R2023 / R2024 = .NET Framework 4.8, R2025 / R2026 = .NET 8
    Revit is NOT needed to build: the Revit API reference assemblies come from NuGet (Nice3point.Revit.Api),
    so every version can be built on one PC.
  -->
  <PropertyGroup>
    <Configurations>R2022;R2023;R2024;R2025;R2026;Debug;Release</Configurations>
    <AssemblyName>RevitCadQC</AssemblyName>
    <RootNamespace>RevitCadQC</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- ACadSharp + Newtonsoft must land in bin\ and be deployed next to RevitCadQC.dll -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);CA1416;MSB3277;NU1505</NoWarn>
    <!-- Normal Windows build uses the WindowsDesktop SDK. On Linux/macOS (CI compile check only) the WPF/WinForms
         reference assemblies come from NuGet instead - possible because no XAML is used. -->
    <UseWPF Condition="'$(OS)' == 'Windows_NT'">true</UseWPF>
    <UseWindowsForms Condition="'$(OS)' == 'Windows_NT'">true</UseWindowsForms>
  </PropertyGroup>

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == '' And $(Configuration.StartsWith('R20'))">$(Configuration.Substring(1))</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <Optimize Condition="$(Configuration.StartsWith('R20'))">true</Optimize>
    <DebugType>portable</DebugType>
    <OutputPath Condition="$(Configuration.StartsWith('R20'))">bin\$(Configuration)\</OutputPath>
    <OutputPath Condition="!$(Configuration.StartsWith('R20'))">bin\$(Configuration)\$(RevitVersion)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2022' Or '$(RevitVersion)' == '2023' Or '$(RevitVersion)' == '2024'">
    <TargetFramework>net48</TargetFramework>
    <DefineConstants>$(DefineConstants);NET48</DefineConstants>
  </PropertyGroup>
  <!-- Revit 2025 / 2026 run on .NET 8. If Autodesk moves an installed Revit to .NET 10, change this to
       net10.0-windows and rebuild everything. -->
  <PropertyGroup Condition="'$(RevitVersion)' != '2022' And '$(RevitVersion)' != '2023' And '$(RevitVersion)' != '2024'">
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <!-- only the add-in sources: tests and the command-line runner are separate projects -->
  <ItemGroup>
    <Compile Remove="Tests\**;Cli\**;bin\**;obj\**;docs\**" />
    <None Remove="Tests\**;Cli\**;bin\**;obj\**;docs\**" />
    <EmbeddedResource Remove="Tests\**;Cli\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Reads DWG directly. Pinned to the SAME version AashirTools ships, so both add-ins load side by side
         in one Revit session without an assembly version clash. -->
    <PackageReference Include="ACadSharp" Version="[3.6.35]" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <!-- Linux/macOS compile check only -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT' And '$(TargetFramework)' != 'net48'">
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Ref" Version="[8.0.0]" />
    <Reference Include="$(NuGetPackageRoot)microsoft.windowsdesktop.app.ref/8.0.0/ref/net8.0/*.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT' And '$(TargetFramework)' == 'net48'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- shipped next to the DLL -->
  <ItemGroup>
    <None Update="RevitCadQC.addin" CopyToOutputDirectory="PreserveNewest" />
    <None Update="CadLayerDictionary.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="CadQcConfig.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
