<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>CadQC.Core</RootNamespace>
    <AssemblyName>CadQC.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Reads DWG directly (no ODA/AutoCAD needed). Pinned to the SAME version AashirTools ships, so both
         add-ins can load side by side in one Revit session without an assembly version clash. -->
    <PackageReference Include="ACadSharp" Version="[3.6.35]" />
  </ItemGroup>
</Project>
