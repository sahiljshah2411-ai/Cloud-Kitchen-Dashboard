<Project Sdk="Microsoft.NET.Sdk">
  <!--
    One project, several Revit versions. Pick the version at build time:
      dotnet build -c Release -p:RevitVersion=2024   (Revit 2024, .NET Framework 4.8)
      dotnet build -c Release -p:RevitVersion=2025   (Revit 2025, .NET 8)   [default]
      dotnet build -c Release -p:RevitVersion=2026   (Revit 2026, .NET 8)
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' != '2024'">net8.0-windows</TargetFramework>
    <!-- Normal Windows build uses the WindowsDesktop SDK. On Linux/macOS (CI compile check only) the WPF/WinForms
         reference assemblies are taken from NuGet instead, because no XAML is used. -->
    <UseWPF Condition="'$(OS)' == 'Windows_NT'">true</UseWPF>
    <UseWindowsForms Condition="'$(OS)' == 'Windows_NT'">true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CadQC.Revit</RootNamespace>
    <AssemblyName>CadQC.Revit</AssemblyName>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);CA1416;MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' != 'Windows_NT' And '$(TargetFramework)' != 'net48'">
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Ref" Version="[8.0.0]" />
    <Reference Include="$(NuGetPackageRoot)microsoft.windowsdesktop.app.ref/8.0.0/ref/net8.0/*.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT' And '$(TargetFramework)' == 'net48'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CadQC.Core\CadQC.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CadQC.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
