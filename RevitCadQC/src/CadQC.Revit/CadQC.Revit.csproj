<Project Sdk="Microsoft.NET.Sdk">
  <!--
    One project, one build configuration per Revit version (same pattern as AashirTools):
      dotnet build -c R2022    Revit 2022  (.NET Framework 4.8)  -> bin\R2022\
      dotnet build -c R2023    Revit 2023  (.NET Framework 4.8)  -> bin\R2023\
      dotnet build -c R2024    Revit 2024  (.NET Framework 4.8)  -> bin\R2024\
      dotnet build -c R2025    Revit 2025  (.NET 8)              -> bin\R2025\
      dotnet build -c R2026    Revit 2026  (.NET 8)              -> bin\R2026\
    Debug/Release still work and build Revit 2025 (or -p:RevitVersion=XXXX).
  -->
  <PropertyGroup>
    <Configurations>R2022;R2023;R2024;R2025;R2026;Debug;Release</Configurations>
    <RevitVersion Condition="'$(RevitVersion)' == '' And $(Configuration.StartsWith('R20'))">$(Configuration.Substring(1))</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <Optimize Condition="$(Configuration.StartsWith('R20'))">true</Optimize>
    <DebugType>portable</DebugType>
    <TargetFramework Condition="'$(RevitVersion)' == '2022' Or '$(RevitVersion)' == '2023' Or '$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0-windows</TargetFramework>
    <!-- Normal Windows build uses the WindowsDesktop SDK. On Linux/macOS (CI compile check only) the WPF/WinForms
         reference assemblies are taken from NuGet instead, because no XAML is used. -->
    <UseWPF Condition="'$(OS)' == 'Windows_NT'">true</UseWPF>
    <UseWindowsForms Condition="'$(OS)' == 'Windows_NT'">true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CadQC.Revit</RootNamespace>
    <AssemblyName>CadQC.Revit</AssemblyName>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <OutputPath Condition="$(Configuration.StartsWith('R20'))">bin\$(Configuration)\</OutputPath>
    <OutputPath Condition="!$(Configuration.StartsWith('R20'))">bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);CA1416;MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' != 'Windows_NT' And '$(TargetFramework)' != 'net48'">
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Ref" Version="[8.0.0]" />
    <Reference Include="$(NuGetPackageRoot)microsoft.windowsdesktop.app.ref/8.0.0/ref/net8.0/*.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT' And '$(TargetFramework)' == 'net48'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CadQC.Core\CadQC.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CadQC.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
